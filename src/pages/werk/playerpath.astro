---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Check from '../../components/Check.astro';
import { playerpath } from '../../data/site';

import dashboard from '../../assets/verslag/playerpath/dashboard.webp';
import trainingen from '../../assets/verslag/playerpath/trainingen.webp';
import betalingen from '../../assets/verslag/playerpath/betalingen.webp';
import mobiel from '../../assets/verslag/playerpath/inschrijven-mobiel.webp';
import kaarten from '../../assets/verslag/playerpath/kaarten.webp';

/**
 * De pagina over PlayerPath. Half verslag, half promotie: wat het is,
 * voor wie, hoe het werkt, wat het kost, en hoe het gebouwd is.
 *
 * De tekst staat in src/data/site.ts (export const playerpath). De
 * schermafbeeldingen komen uit de voorbeeldschool in de app, nooit van
 * echte spelers: het gaat om kinderen. Een paar goed gekozen beelden,
 * de rest is tekst.
 */
const p = playerpath;
const { verslag } = p;

const gegevens = [
  { term: 'Soort', waarde: p.soort },
  { term: 'Gebouwd met', waarde: 'Laravel, Vue en Inertia' },
  { term: 'Rol', waarde: 'Idee, ontwerp en ontwikkeling' },
];
---

<BaseLayout
  title="PlayerPath, software voor voetbalscholen | Sitefront"
  description="PlayerPath is software voor keeper- en voetbalscholen: inschrijven, trainingen, betalen via Mollie en een spelerskaart die meegroeit. Bedacht en gebouwd door Sitefront met Laravel, Vue en Inertia."
>
  <SiteHeader />

  <main>
    <!-- Kop -->
    <section id="main" class="bg-brand rounded-b-[2rem] md:rounded-b-[3rem]">
      <div class="mx-auto w-full max-w-page px-5 pt-32 pb-40 md:px-8 md:pt-40 md:pb-56 xl:px-10">
        <div class="mx-auto max-w-3xl">
          <a href="/#werk" class="label text-white/60 ease-soft transition-colors duration-150 hover:text-white">
            <span aria-hidden="true">&larr;</span> Terug naar het werk
          </a>

          <p class="label text-accent mt-8">Eigen product · SaaS</p>
          <h1 class="text-4xl mt-4 font-heavy text-white">
            PlayerPath: minder administratie, betere spelers
          </h1>
          <p class="mt-5 text-xl leading-[1.55] text-white/75">{p.kort}</p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={p.site}
              target="_blank"
              rel="noopener"
              class="bg-accent text-ink shadow-btn font-display ease-soft rounded-full px-5 py-2.5 text-base font-bold transition-colors duration-150 hover:bg-white"
            >
              Bekijk playerpath.nl <span aria-hidden="true">&nearr;</span>
            </a>
            <a
              href={p.demo}
              target="_blank"
              rel="noopener"
              class="border-line-navy font-display ease-soft rounded-full border px-5 py-2.5 text-base font-bold text-white transition-colors duration-150 hover:bg-white/10"
            >
              Vraag een demo aan
            </a>
          </div>

          <dl class="border-line-navy mt-10 grid gap-x-8 gap-y-4 border-t pt-6 sm:grid-cols-3">
            {
              gegevens.map((g) => (
                <div>
                  <dt class="text-sm text-white/55">{g.term}</dt>
                  <dd class="text-base font-medium text-white">{g.waarde}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- Het dashboard, over de rand van het blauw -->
    <div class="relative z-10 mx-auto -mt-28 w-full max-w-page px-5 md:-mt-40 md:px-8 xl:px-10">
      <figure class="mx-auto max-w-5xl">
        <Image
          src={dashboard}
          alt="Het dashboard van de schooleigenaar: actieve spelers, gemiddelde rating, rapporten en omzet."
          widths={[600, 1000, 1400, 2000]}
          sizes="(min-width: 1024px) 64rem, 94vw"
          class="shadow-lift border-line-soft block h-auto w-full rounded-2xl border"
          loading="eager"
        />
        <figcaption class="text-soft mt-3 text-center text-sm">
          Het dashboard van de eigenaar, met de gegevens van de voorbeeldschool.
        </figcaption>
      </figure>
    </div>

    <article class="verslag mx-auto w-full max-w-3xl px-5 py-16 md:px-8 md:py-24">
      <h2>Wat is PlayerPath?</h2>
      {p.watIsHet.map((alinea) => <p>{alinea}</p>)}

      <h2>Het probleem dat het oplost</h2>
      <p>{verslag.probleem}</p>
      <p>
        PlayerPath vervangt die zes losse dingen door één systeem. Excel wordt een administratie die
        altijd klopt, de WhatsApp-groep wordt mededelingen per groep, Tikkies worden incasso die vanzelf
        loopt, en het gevoel over een speler wordt een rapport met cijfers dat ouders direct zien.
      </p>

      <h2>Voor wie het is</h2>
      <p>Vier soorten gebruikers, en ieder krijgt een eigen scherm met alleen wat voor hem bedoeld is.</p>
      <dl class="rollen">
        {
          p.voorWie.map((r) => (
            <div>
              <dt>{r.rol}</dt>
              <dd>{r.tekst}</dd>
            </div>
          ))
        }
      </dl>

      <h2>Hoe het werkt</h2>
      {
        p.hoeHetWerkt.slice(0, 2).map((stap) => (
          <>
            <h3>{stap.titel}</h3>
            <p>{stap.tekst}</p>
          </>
        ))
      }

      <figure class="breed grid items-center gap-6 sm:grid-cols-[minmax(0,1fr)_minmax(0,12rem)]">
        <Image
          src={trainingen}
          alt="Het trainingsrooster met aanwezigheid en vrije plekken."
          widths={[600, 1000, 1400]}
          sizes="(min-width: 1024px) 42rem, 94vw"
          class="shadow-card border-line-soft block h-auto w-full rounded-xl border"
          loading="lazy"
        />
        <Image
          src={mobiel}
          alt="Het inschrijfformulier van een school op een telefoon."
          widths={[240, 400]}
          sizes="12rem"
          class="border-ink shadow-card mx-auto aspect-9/19 w-44 rounded-[1.5rem] border-[5px] object-cover object-top sm:w-full"
          loading="lazy"
        />
        <figcaption class="sm:col-span-2">
          Links het rooster voor de school, rechts de aanmeldpagina zoals een ouder hem op de telefoon ziet.
        </figcaption>
      </figure>

      {
        p.hoeHetWerkt.slice(2).map((stap) => (
          <>
            <h3>{stap.titel}</h3>
            <p>{stap.tekst}</p>
          </>
        ))
      }

      <figure class="breed">
        <Image
          src={betalingen}
          alt="Het betalingsoverzicht: ontvangen, openstaand en achterstallig."
          widths={[600, 1000, 1400]}
          sizes="(min-width: 1024px) 56rem, 94vw"
          class="shadow-card border-line-soft block h-auto w-full rounded-xl border"
          loading="lazy"
        />
        <figcaption>Het betalingsoverzicht: wat er binnenkwam, wat openstaat en wat misging.</figcaption>
      </figure>

      <h2>De spelerskaart</h2>
      {p.kaart.map((alinea) => <p>{alinea}</p>)}
    </article>

    <!-- De kaarten krijgen een donker vlak, zoals ze in de app ook staan.
         bg-ink en niet bg-brand: de afbeelding heeft zelf een bijna
         zwarte achtergrond, en op het blauw zag je daardoor een blok. -->
    <figure class="bg-ink mx-auto w-full max-w-page overflow-hidden px-5 py-12 md:rounded-[2rem] md:px-8 xl:px-10">
      <Image
        src={kaarten}
        alt="Vier spelerskaarten naast elkaar, van brons via zilver en goud tot elite."
        widths={[500, 760]}
        sizes="(min-width: 768px) 38rem, 94vw"
        class="mx-auto block h-auto w-full max-w-2xl"
        loading="lazy"
      />
      <figcaption class="mt-4 text-center text-sm text-white/60">
        Van brons tot elite. Het frame van de kaart laat zien op welk level een speler zit.
      </figcaption>
    </figure>

    <article class="verslag mx-auto w-full max-w-3xl px-5 py-16 md:px-8 md:py-24">
      <h2>Wat het allemaal kan</h2>
      <ul class="functies">
        {
          verslag.functies.map((f) => (
            <li>
              <Check class="text-mint mt-1" />
              {f}
            </li>
          ))
        }
      </ul>

      <h2>Wat PlayerPath bewust niet doet</h2>
      <p>Wat je weglaat zegt net zoveel als wat je bouwt. Deze vier keuzes zijn met opzet zo gemaakt.</p>
      <dl class="rollen">
        {
          p.keuzes.map((k) => (
            <div>
              <dt>{k.titel}</dt>
              <dd>{k.tekst}</dd>
            </div>
          ))
        }
      </dl>

      <h2>Wat het kost</h2>
      <p>
        Eén vast bedrag per maand, hoeveel spelers een school ook heeft. Geen opstartkosten, maandelijks
        opzegbaar, en elke maand wisselen van pakket mag. Alle bedragen zijn exclusief btw.
      </p>
      <ul class="pakketten">
        {
          p.pakketten.map((pk) => (
            <li>
              <p class="text-soft text-sm">{pk.voor}</p>
              <p class="font-display text-ink mt-1 text-xl font-black">{pk.naam}</p>
              <p class="mt-2">
                <span class="font-display text-ink text-3xl font-heavy">&euro;{pk.prijs}</span>
                <span class="text-soft text-sm"> per maand</span>
              </p>
              <p class="text-body mt-3 text-base leading-[1.55]">{pk.tekst}</p>
            </li>
          ))
        }
      </ul>

      <h2>Hoe het gebouwd is</h2>
      {
        verslag.aanpak.map((stap) => (
          <>
            <h3>{stap.titel}</h3>
            <p>{stap.tekst}</p>
          </>
        ))
      }

      <h3>De techniek</h3>
      <p>
        Laravel, Inertia en Vue. De Laravel-controller haalt de gegevens op en controleert wie wat mag
        zien, Inertia geeft ze mee aan de pagina, en het Vue-component krijgt ze binnen als props. Een
        losse API ertussen is daardoor niet nodig. Het geheel wordt bewaakt door bijna achthonderd
        geautomatiseerde tests.
      </p>
      <dl class="stack">
        {
          p.stack.map((laag) => (
            <div>
              <dt>{laag.laag}</dt>
              <dd>
                <span class="text-ink font-medium">{laag.items.join(', ')}</span>
                <span class="text-body mt-1 block">{laag.waarom}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <h2>Wat ik ervan leerde</h2>
      {
        verslag.geleerd.map((les) => (
          <>
            <h3>{les.titel}</h3>
            <p>{les.tekst}</p>
          </>
        ))
      }

      <!-- Twee afsluiters: één voor een voetbalschool, één voor iemand
           die zelf iets gebouwd wil hebben. -->
      <div class="afsluiter">
        <div>
          <p class="font-display text-ink text-xl font-black">Heb je een voetbal- of keeperschool?</p>
          <p class="text-body mt-2 text-base">
            Bekijk wat PlayerPath voor jouw school doet en vraag een vrijblijvende demo aan.
          </p>
          <a href={p.site} target="_blank" rel="noopener" class="knop">
            Naar playerpath.nl <span aria-hidden="true">&nearr;</span>
          </a>
        </div>
        <div>
          <p class="font-display text-ink text-xl font-black">Zelf iets laten bouwen?</p>
          <p class="text-body mt-2 text-base">
            Wat voor een voetbalschool kan, kan ook voor jouw bedrijf. Vertel waar het schuurt.
          </p>
          <a href="/#contact" class="knop">Plan een gesprek</a>
        </div>
      </div>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* Eén leeskolom met een vast ritme. Hier en niet met losse klassen op
     elke alinea, zodat de tekst in de template leesbaar blijft. */
  .verslag :global(h2) {
    font-size: var(--text-3xl);
    margin-top: 3.5rem;
  }
  .verslag :global(h2:first-child) {
    margin-top: 0;
  }
  .verslag :global(h3) {
    font-size: var(--text-xl);
    margin-top: 1.75rem;
  }
  .verslag :global(p) {
    line-height: 1.7;
  }
  .verslag :global(h2 + p),
  .verslag :global(h3 + p) {
    margin-top: 0.625rem;
  }
  .verslag :global(p + p) {
    margin-top: 1rem;
  }

  /* Beelden mogen iets breder dan de tekst, zodat ze leesbaar zijn. */
  .breed {
    margin-block: 2.5rem;
  }
  @media (min-width: 64rem) {
    .breed {
      margin-inline: -5rem;
    }
  }
  .breed :global(figcaption) {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-soft);
  }

  .rollen,
  .stack {
    margin-top: 1.25rem;
  }
  .rollen > div,
  .stack > div {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-base);
    line-height: 1.6;
  }
  @media (min-width: 40rem) {
    .rollen > div,
    .stack > div {
      grid-template-columns: 11rem 1fr;
    }
  }
  .rollen dt,
  .stack dt {
    font-family: var(--font-display);
    font-weight: var(--font-weight-black);
    color: var(--color-ink);
  }

  .functies {
    margin-top: 1rem;
    display: grid;
    gap: 0.625rem 2rem;
  }
  @media (min-width: 40rem) {
    .functies {
      grid-template-columns: 1fr 1fr;
    }
  }
  .functies li {
    display: flex;
    gap: 0.625rem;
    color: var(--color-ink);
    font-size: var(--text-base);
  }

  .pakketten {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .pakketten {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pakketten li {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  .afsluiter {
    margin-top: 4rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .afsluiter {
      grid-template-columns: 1fr 1fr;
    }
  }
  .afsluiter > div {
    background-color: var(--color-sand);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .knop {
    margin-top: 1.25rem;
    border-radius: var(--radius-full);
    background-color: var(--color-navy);
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-base);
    padding: 0.5rem 1.125rem;
    transition: background-color 150ms var(--ease-soft);
  }
  .knop:hover {
    background-color: var(--color-ink);
  }
</style>

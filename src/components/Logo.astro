---
/**
 * Het Sitefront-logo.
 *
 * Het aangeleverde bestand was met imagetracer.js uit een PNG getrokken:
 * 110 paden, waarvan er 97 ruis waren (haarlijntjes van de anti-aliasing)
 * plus een dekkend vlak dat het logo onbruikbaar maakte op een donkere
 * achtergrond. Hieronder staan alleen de 13 paden die het logo echt zijn.
 *
 * De vulling is currentColor, dus het logo neemt de tekstkleur over van
 * waar het staat. Donker in de kop, wit in de voet, zonder tweede bestand.
 *
 * fill-rule evenodd is nodig voor de gaten in de e en de o.
 */
interface Props {
  class?: string;
  /** Zet op true wanneer er vlak ernaast al "Sitefront" staat. */
  decoratief?: boolean;
}

const { class: klasse = '', decoratief = false } = Astro.props;
---

<svg
  viewBox="16 17 284 85"
  class={klasse}
  fill="currentColor"
  fill-rule="evenodd"
  role={decoratief ? undefined : 'img'}
  aria-hidden={decoratief ? 'true' : undefined}
  aria-label={decoratief ? undefined : 'Sitefront'}
>

---
import lighthouse from '../data/lighthouse.json';

/**
 * De meter. Dit is het enige blok op de site dat niet beweert maar meet.
 *
 * Twee soorten cijfers, en het verschil is expres zichtbaar:
 *  - Boven: wat er zojuist in de browser van de bezoeker zelf gebeurde.
 *    Uit de Performance API, dus geen dienst, geen sleutel, geen backend.
 *  - Onder: de Lighthouse-uitslag uit src/data/lighthouse.json. Die wordt
 *    daar alleen ingevuld na een echte run. Niets gemeten is een streepje,
 *    geen verzonnen honderd.
 *
 * Dit was eerder het signatuurelement van de hero en stond geparkeerd
 * omdat twee opvallende dingen naast elkaar niet werkt. Hier verderop
 * doet het wat het hoort te doen: de belofte "snelle websites" staven op
 * het moment dat iemand zich afvraagt of dat waar is.
 */

const scores = lighthouse.scores;
const gemeten = typeof scores.performance === 'number';

const categorieen = [
  { label: 'Prestatie', waarde: scores.performance },
  { label: 'Toegankelijk', waarde: scores.accessibility },
  { label: 'Best practices', waarde: scores.bestPractices },
  { label: 'SEO', waarde: scores.seo },
] as const;

const datum = lighthouse.measuredAt
  ? new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }).format(
      new Date(lighthouse.measuredAt),
    )
  : null;

/* PageSpeed Insights kan geen localhost bereiken. Zolang de meting niet
   op het live domein is gedaan, linken we naar het formulier in plaats
   van naar een analyse die meteen faalt. */
const nametenUrl =
  lighthouse.url && lighthouse.isPublicUrl
    ? `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(lighthouse.url)}`
    : 'https://pagespeed.web.dev/';

const toelichting = !gemeten
  ? 'Nog niet gemeten, daarom streepjes.'
  : lighthouse.strategy === 'mobile'
    ? `Mobiel gemeten op ${datum}, de strengere van de twee: Lighthouse remt processor en netwerk af.`
    : `Gemeten op ${datum}.`;
---

<section id="bewijs" class="bg-sand scroll-mt-24 py-20 md:py-28">
  <div class="mx-auto w-full max-w-page px-5 md:px-8 xl:px-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-16">
      <div>
        <p class="label text-accent-ink">Bewijs</p>
        <h2 class="text-3xl tracking-head leading-head mt-3 font-black text-ink">
          Snel is een getal, geen bijvoeglijk naamwoord.
        </h2>
        <p class="text-body mt-5 text-base leading-[1.6]">
          Iedereen zet "snelle websites" op zijn homepage. Hiernaast staat wat deze pagina
          zojuist in jouw browser deed, en daaronder de laatste Lighthouse-uitslag. Je kunt
          het allebei zelf nameten.
        </p>
      </div>

      <figure
        data-meter
        data-status="pending"
        class="border-line shadow-card relative grid self-start rounded-xl border bg-paper"
      >
        <!-- Snijtekens op twee hoeken. Een meetinstrument heeft ze, een
             marketingkaart niet. Dit is het hele verschil in toon. -->
        <span
          class="border-accent pointer-events-none absolute -top-px -left-px size-2.5 border-t border-l"
          aria-hidden="true"></span>
        <span
          class="border-accent pointer-events-none absolute -right-px -bottom-px size-2.5 border-r border-b"
          aria-hidden="true"></span>

        <figcaption
          class="border-line flex items-center justify-between gap-4 border-b px-5 py-3 md:px-6"
        >
          <span class="label text-body inline-flex items-center gap-2">
            <span class="stip" aria-hidden="true"></span>
            Live
          </span>
          <span class="label text-soft">gemeten in jouw browser</span>
        </figcaption>

        <div class="px-5 pt-5 pb-6 md:px-6">
          <p class="label text-soft">Grootste element zichtbaar</p>

          <!-- min-h houdt de regel op hoogte terwijl de streepjes nog
               cijfers moeten worden, anders verspringt de pagina. -->
          <p class="mt-2.5 flex min-h-11 flex-wrap items-baseline gap-x-2">
            <output
              data-uit="lcp"
              class="font-display text-4xl leading-none font-heavy text-ink tabular-nums"
              >–,––</output
            >
            <span data-uit="lcp-eenheid" class="font-display text-xl font-bold text-soft">s</span>
            <span data-uit="oordeel" class="label text-soft ml-1">meten…</span>
          </p>

          <!-- De balk loopt tot 4 seconden; de streep staat op 2,5, de
               grens die Google "goed" noemt. -->
          <div class="mt-5" aria-hidden="true">
            <div class="bg-line relative h-1.5 overflow-hidden rounded-full">
              <div
                data-balk
                class="bg-accent h-full w-0 rounded-full transition-[width] duration-700 ease-soft"
              >
              </div>
              <span class="bg-line-strong absolute top-0 h-full w-px" style="left: 62.5%"></span>
            </div>
            <p class="text-soft relative mt-2 h-4 text-xs tabular-nums">
              <span class="absolute left-0">0</span>
              <span class="absolute -translate-x-1/2 whitespace-nowrap" style="left: 62.5%">
                2,5 s is goed
              </span>
              <span class="absolute right-0">4 s</span>
            </p>
          </div>
        </div>

        <dl class="border-line grid border-t sm:grid-cols-3">
          {
            [
              ['Serverreactie', 'ttfb'],
              ['Volledig geladen', 'geladen'],
              ['Paginagewicht', 'gewicht'],
            ].map(([label, sleutel], i) => (
              <div
                class:list={[
                  'px-5 py-4 md:px-6',
                  i > 0 && 'border-line border-t sm:border-t-0 sm:border-l',
                ]}
              >
                <dt class="label text-soft">{label}</dt>
                <dd
                  data-uit={sleutel}
                  class="font-display mt-1.5 min-h-6 text-base font-bold text-ink tabular-nums"
                >
                  –
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="border-line border-t px-5 py-5 md:px-6">
          <p class="label text-soft">Lighthouse</p>
          <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4">
            {
              categorieen.map((c) => (
                <li>
                  <span
                    class:list={[
                      'font-display block text-2xl leading-none font-heavy tabular-nums',
                      c.waarde === 100 ? 'text-accent-ink' : 'text-ink',
                    ]}
                  >
                    {c.waarde ?? '–'}
                  </span>
                  <span
                    class="label text-soft mt-1.5 block text-[0.625rem] leading-[1.3]"
                  >
                    {c.label}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="text-soft mt-4 text-sm leading-[1.5]">
            {toelichting}{' '}
            <a
              class="text-accent-ink underline underline-offset-3 hover:text-ink"
              href={nametenUrl}
              rel="noopener">Meet zelf na<span aria-hidden="true"> →</span></a
            >
          </p>
        </div>

        <p class="sr-only" data-uit="samenvatting" aria-live="polite"></p>
      </figure>
    </div>
  </div>
</section>

<style>
  .stip {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background-color: var(--color-mint);
    animation: kloppen 2.6s var(--ease-soft) infinite;
  }

  @keyframes kloppen {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stip {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  const wortel = document.querySelector<HTMLElement>('[data-meter]');

  if (wortel && 'performance' in window) {
    const nl = (n: number, d = 0) =>
      n.toLocaleString('nl-NL', { minimumFractionDigits: d, maximumFractionDigits: d });

    const zet = (sleutel: string, tekst: string) => {
      const el = wortel.querySelector<HTMLElement>(`[data-uit="${sleutel}"]`);
      if (el) el.textContent = tekst;
    };

    /* Onder de seconde in milliseconden, daarboven in seconden. Dat leest
       prettiger dan overal hetzelfde. */
    const duur = (ms: number) => (ms < 1000 ? `${nl(ms)} ms` : `${nl(ms / 1000, 2)} s`);

    const rustig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let lcp = 0;
    try {
      new PerformanceObserver((lijst) => {
        for (const entry of lijst.getEntries()) lcp = entry.startTime;
      }).observe({ type: 'largest-contentful-paint', buffered: true });
    } catch {
      /* Oudere Safari kent LCP niet; dan vallen we terug op first paint. */
    }

    const telNaar = (el: HTMLElement, doel: number, toon: (v: number) => string) => {
      /* Eerst de eindwaarde neerzetten: in een achtergrondtab draait
         requestAnimationFrame niet, en dan moet het cijfer er tóch staan. */
      el.textContent = toon(doel);
      if (rustig) return;

      const begin = performance.now();
      const duurMs = 650;
      const stap = (nu: number) => {
        const t = Math.min((nu - begin) / duurMs, 1);
        const vloeiend = 1 - Math.pow(1 - t, 3);
        el.textContent = toon(doel * vloeiend);
        if (t < 1) requestAnimationFrame(stap);
      };
      requestAnimationFrame(stap);
    };

    const meet = () => {
      const nav = performance.getEntriesByType('navigation')[0] as
        | PerformanceNavigationTiming
        | undefined;
      if (!nav) return;

      if (!lcp) {
        const fcp = performance.getEntriesByName('first-contentful-paint')[0];
        lcp = fcp ? fcp.startTime : nav.domContentLoadedEventEnd;
      }

      const ttfb = Math.max(0, nav.responseStart - nav.requestStart);
      const geladen = nav.loadEventEnd || nav.domComplete;

      const bytes =
        performance
          .getEntriesByType('resource')
          .reduce((som, r) => som + ((r as PerformanceResourceTiming).transferSize || 0), 0) +
        (nav.transferSize || 0);

      const status = lcp <= 2500 ? 'goed' : lcp <= 4000 ? 'matig' : 'traag';
      wortel.dataset.status = status;

      const oordeel = wortel.querySelector<HTMLElement>('[data-uit="oordeel"]');
      if (oordeel) {
        oordeel.textContent = status;
        oordeel.classList.remove('text-soft');
        oordeel.classList.add(
          /* mint-ink en niet mint: de lichte mint haalt op wit maar 3,4:1
             en dit is tekst van 13 pixels, die 4,5 nodig heeft. */
          status === 'goed' ? 'text-mint-ink' : status === 'matig' ? 'text-accent-ink' : 'text-bad',
        );
      }

      const waarde = wortel.querySelector<HTMLElement>('[data-uit="lcp"]');
      const eenheid = wortel.querySelector<HTMLElement>('[data-uit="lcp-eenheid"]');
      if (waarde && eenheid) {
        if (lcp < 1000) {
          eenheid.textContent = 'ms';
          telNaar(waarde, lcp, (v) => nl(v));
        } else {
          eenheid.textContent = 's';
          telNaar(waarde, lcp / 1000, (v) => nl(v, 2));
        }
      }

      const balk = wortel.querySelector<HTMLElement>('[data-balk]');
      if (balk) balk.style.width = `${Math.min((lcp / 4000) * 100, 100)}%`;

      zet('ttfb', duur(ttfb));
      zet('geladen', duur(geladen));
      const kb = bytes / 1024;
      zet('gewicht', kb >= 5 ? `${nl(kb)} kB` : kb > 0 ? 'uit cache' : 'onbekend');

      zet(
        'samenvatting',
        `Deze pagina is zojuist gemeten: grootste element zichtbaar na ${duur(lcp)} (${status}), serverreactie ${duur(ttfb)}, volledig geladen na ${duur(geladen)}.`,
      );
    };

    /* loadEventEnd bestaat pas ná het load-event, vandaar de timeout van 0. */
    if (document.readyState === 'complete') {
      setTimeout(meet, 0);
    } else {
      window.addEventListener('load', () => setTimeout(meet, 0), { once: true });
    }
  }
</script>

---
import Beeldmerk from './Beeldmerk.astro';
import Snelheidsregel from './Snelheidsregel.astro';

/**
 * Hero. Drie dingen: kop, één alinea, twee knoppen. Meer niet.
 *
 * De rechterhelft is gevuld met het eigen beeldmerk, enorm uitvergroot
 * en op vijf procent dekking, half over de rand heen. Het is geen
 * plaatje en geen versiering uit een bibliotheek: het is het merk zelf,
 * dus dit kan per definitie op geen enkele andere site staan.
 */
---

<section id="main" class="bg-brand relative isolate overflow-hidden rounded-b-[2rem] md:rounded-b-[3rem]">
  <!-- Eén zachte lichtplek, en die staat stil. Een bewegende gradient is
       precies waar een pagina goedkoop van gaat ogen. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="absolute -top-1/3 -right-1/4 h-[70rem] w-[70rem] rounded-full opacity-40"
      style="background: radial-gradient(closest-side, #14418f 0%, transparent 70%)"
    >
    </div>
  </div>
  <!-- Het beeldmerk, uitvergroot en afgesneden door de rand van de
       sectie. Op vijf procent leest het als textuur, niet als logo. -->
  <Beeldmerk
    class="pointer-events-none absolute -top-16 -right-24 -z-10 hidden h-[42rem] w-auto text-white opacity-[0.05] sm:block lg:-right-16 lg:h-[52rem]"
  />

  <div
    class="mx-auto w-full max-w-page px-5 pt-36 pb-40 md:px-8 md:pt-48 md:pb-48 xl:px-10"
  >
    <div>

      <h1 style="--regel: 10.6" class="kop-past leading-hero tracking-hero mt-7 max-w-[19ch] font-heavy text-white">
        Software op maat.<br />
        Websites die werken.<br />
        <span class="text-accent relative inline-block">
          Zelf gebouwd.
          <!-- Met de hand uitgezette streep, die zichzelf tekent bij het
               laden. Eén detail dat uit geen enkel sjabloon kan komen. -->
          <svg
            class="onderstreep text-accent"
            viewBox="0 0 300 12"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M3 8.2C48 4.1 96 9.4 143 6.2c39-2.6 78 3.1 116 0.4"
              fill="none"
              stroke="currentColor"
              stroke-width="4.5"
              stroke-linecap="round"
            ></path>
          </svg>
        </span>
      </h1>

      <p class="text-lg mt-8 max-w-[46ch] leading-[1.6] text-white/75">
        Ik kijk eerst hoe jouw bedrijf werkt en waar het schuurt, en bouw daar de oplossing
        omheen. Soms is dat een website, vaak een systeem, en regelmatig allebei.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="/#contact"
          class="bg-accent text-ink shadow-btn font-display rounded-full px-5 py-2.5 text-base font-bold transition-colors duration-150 ease-soft hover:bg-white"
        >
          Plan een gesprek
        </a>
        <a
          href="/#werk"
          class="border-line-navy font-display rounded-full border px-7 py-4 text-lg font-bold text-white transition-colors duration-150 ease-soft hover:bg-white/10"
        >
          Bekijk het werk
        </a>
      </div>

      <Snelheidsregel />
    </div>

  </div>
</section>

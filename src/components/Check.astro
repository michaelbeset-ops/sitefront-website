---
/** Klein vinkje. Eén plek, zodat ze overal identiek zijn. */
interface Props {
  class?: string;
}
const { class: klasse = '' } = Astro.props;
---

<svg
  viewBox="0 0 20 20"
  class={`size-5 shrink-0 ${klasse}`}
  fill="none"
  stroke="currentColor"
  stroke-width="2.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M4 10.5 8 14.5 16 6" />
</svg>

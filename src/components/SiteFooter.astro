---
import Logo from './Logo.astro';
import { bedrijf, navigatie } from '../data/site';

const jaar = new Date().getFullYear();
---

<footer class="voet bg-navy-deep py-14">
  <div class="mx-auto w-full max-w-page px-5 md:px-8 xl:px-10">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr]">
      <div>
        <Logo class="h-9 w-auto text-white" />
        <p class="mt-3 max-w-[34ch] text-base text-white/70">
          Freelance software en websites, gebouwd in {bedrijf.plaats}.
        </p>
      </div>

      <nav aria-label="Footer">
        <p class="label text-white/50">Menu</p>
        <ul class="mt-4 space-y-2.5 text-base">
          {
            navigatie.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-white/80 transition-colors duration-150 ease-soft hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <!-- Staat niet in het hoofdmenu, maar moet wel vindbaar blijven. -->
          <li>
            <a
              href="/software-op-maat"
              class="text-white/80 transition-colors duration-150 ease-soft hover:text-white"
            >
              Software op maat
            </a>
          </li>
        </ul>
      </nav>

      <div>
        <p class="label text-white/50">Gegevens</p>
        <ul class="mt-4 space-y-2.5 text-base text-white/80">
          <li>
            <a
              class="underline decoration-white/30 underline-offset-4 transition-colors duration-150 hover:text-white"
              href={`mailto:${bedrijf.email}`}
            >
              {bedrijf.email}
            </a>
          </li>
          <li>KvK {bedrijf.kvk}</li>
          {bedrijf.btw && <li>BTW {bedrijf.btw}</li>}
        </ul>

        <p class="label mt-7 text-white/50">Juridisch</p>
        <ul class="mt-4 space-y-2.5 text-base">
          <li>
            <a
              href="/algemene-voorwaarden"
              class="text-white/80 transition-colors duration-150 ease-soft hover:text-white"
            >
              Algemene voorwaarden
            </a>
          </li>
          <li>
            <a
              href="/privacybeleid"
              class="text-white/80 transition-colors duration-150 ease-soft hover:text-white"
            >
              Privacybeleid
            </a>
          </li>
          <li>
            <a
              href="/cookiebeleid"
              class="text-white/80 transition-colors duration-150 ease-soft hover:text-white"
            >
              Cookiebeleid
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-white/15 pt-6">
      <p class="text-sm text-white/50">&copy; {jaar} {bedrijf.naam}</p>

      <div class="flex items-center gap-5">
      <a
        href={bedrijf.linkedin}
        target="_blank"
        rel="noopener"
        class="ease-soft flex items-center gap-2 text-sm text-white/70 transition-colors duration-150 hover:text-white"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z" />
        </svg>
        LinkedIn
      </a>
      <a
        href={bedrijf.instagram}
        target="_blank"
        rel="noopener"
        class="ease-soft flex items-center gap-2 text-sm text-white/70 transition-colors duration-150 hover:text-white"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
          <circle cx="12" cy="12" r="4.25"></circle>
          <circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" stroke="none"></circle>
        </svg>
        sitefrontnl
      </a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Onder de voet ligt de achtergrond van html, en die is iets lichter
     blauw omdat hij bij de bovenkant van de pagina hoort. Bij het
     terugveren aan de onderkant van een telefoon zag je dat verschil.
     Deze schaduw schildert de voetkleur een half scherm door naar
     beneden. Het kost geen ruimte in de opmaak en geeft dus ook geen
     extra schuifbalk. */
  .voet {
    box-shadow: 0 50vh 0 var(--color-navy-deep);
  }
</style>
